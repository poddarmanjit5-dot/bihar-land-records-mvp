# Environment Configuration Template

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bihar_land_records
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# PostGIS
POSTGIS_ENABLED=true
POSTGIS_VERSION=3.2

# API Keys (if using external services)
BHUNAKSHA_API_KEY=
BHUNAKSHA_API_URL=https://bhunaksha.bihar.gov.in

# Authentication (future)
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-session-secret

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Features
ENABLE_ADMIN_API=false
ENABLE_MUTATIONS=true
ENABLE_EXPORT_PDF=false

# GIS
SHAPEFILE_PATH=./gis/shapefiles
GEOJSON_PATH=./gis/geojson
TILE_SIZE=512

# Caching (future)
REDIS_URL=redis://localhost:6379

# Email (future)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=

# Analytics (future)
MIXPANEL_TOKEN=
SENTRY_DSN=